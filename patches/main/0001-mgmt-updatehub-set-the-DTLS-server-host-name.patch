From 4f7085a29556d878578f06aea9eadfb42cd3f4a6 Mon Sep 17 00:00:00 2001
From: Otavio Salvador <otavio@ossystems.com.br>
Date: Fri, 13 Nov 2026 13:07:13 -0300
Subject: [PATCH 1/4] mgmt: updatehub: set the DTLS server host name

The client requires peer verification but never told the TLS socket
which host it expects. Mbed TLS refuses to verify a certificate
without a host name, so the DTLS handshake could never succeed.

Pass the server address as ZSOCK_TLS_HOSTNAME so the certificate is
checked against the name the device actually connects to.

Signed-off-by: Otavio Salvador <otavio@ossystems.com.br>
---
 subsys/mgmt/updatehub/updatehub.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/subsys/mgmt/updatehub/updatehub.c b/subsys/mgmt/updatehub/updatehub.c
index 984d6370351..ee6ba4c6546 100644
--- a/subsys/mgmt/updatehub/updatehub.c
+++ b/subsys/mgmt/updatehub/updatehub.c
@@ -232,6 +232,12 @@ static bool start_coap_client(void)
 		LOG_ERR("Failed to set TLS_PEER_VERIFY option");
 		goto error;
 	}
+
+	if (zsock_setsockopt(ctx.sock, ZSOCK_SOL_TLS, ZSOCK_TLS_HOSTNAME, UPDATEHUB_SERVER,
+			     sizeof(UPDATEHUB_SERVER)) < 0) {
+		LOG_ERR("Failed to set TLS_HOSTNAME option");
+		goto error;
+	}
 #endif
 
 	if (zsock_connect(ctx.sock, addr->ai_addr, addr->ai_addrlen) < 0) {
-- 
