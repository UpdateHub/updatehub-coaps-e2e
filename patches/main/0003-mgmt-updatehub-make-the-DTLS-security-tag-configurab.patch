From 2affb9551e7ccab361bd9726706da2c0d784d98b Mon Sep 17 00:00:00 2001
From: Otavio Salvador <otavio@ossystems.com.br>
Date: Fri, 13 Nov 2026 13:07:39 -0300
Subject: [PATCH 3/4] mgmt: updatehub: make the DTLS security tag configurable

The library hard-coded security tag 1 for the DTLS credentials, which
collides with any other TLS user in the application that picked the
same tag. Add UPDATEHUB_DTLS_SEC_TAG, defaulting to 1 so existing
applications keep working.

Signed-off-by: Otavio Salvador <otavio@ossystems.com.br>
---
 subsys/mgmt/updatehub/Kconfig     | 10 ++++++++++
 subsys/mgmt/updatehub/updatehub.c |  3 +--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/subsys/mgmt/updatehub/Kconfig b/subsys/mgmt/updatehub/Kconfig
index 0403ce49795..d9f836d7886 100644
--- a/subsys/mgmt/updatehub/Kconfig
+++ b/subsys/mgmt/updatehub/Kconfig
@@ -82,6 +82,16 @@ config UPDATEHUB_DTLS
 	  Enables DTLS communication between the UpdateHub
 	  client and the server
 
+config UPDATEHUB_DTLS_SEC_TAG
+	int "Security tag holding the DTLS trust anchor"
+	default 1
+	depends on UPDATEHUB_DTLS
+	help
+	  TLS credentials security tag the client uses for the DTLS
+	  handshake. The application must register the CA certificate that
+	  signs the UpdateHub server certificate under this tag before the
+	  first probe.
+
 config UPDATEHUB_COAP_CONN_TIMEOUT
 	int "CoAP connection timeout in seconds"
 	default 10
diff --git a/subsys/mgmt/updatehub/updatehub.c b/subsys/mgmt/updatehub/updatehub.c
index c4a1a4c1ed6..1459fa87526 100644
--- a/subsys/mgmt/updatehub/updatehub.c
+++ b/subsys/mgmt/updatehub/updatehub.c
@@ -26,7 +26,6 @@ LOG_MODULE_REGISTER(updatehub, CONFIG_UPDATEHUB_LOG_LEVEL);
 #include "updatehub_storage.h"
 
 #if defined(CONFIG_UPDATEHUB_DTLS)
-#define CA_CERTIFICATE_TAG 1
 #include <zephyr/net/tls_credentials.h>
 #endif
 
@@ -188,7 +187,7 @@ static bool start_coap_client(void)
 
 #if defined(CONFIG_UPDATEHUB_DTLS)
 	int verify = ZSOCK_TLS_PEER_VERIFY_REQUIRED;
-	sec_tag_t sec_list[] = { CA_CERTIFICATE_TAG };
+	sec_tag_t sec_list[] = {CONFIG_UPDATEHUB_DTLS_SEC_TAG};
 	int protocol = NET_IPPROTO_DTLS_1_2;
 	char port[] = "5684";
 #else
-- 
2.56.0

