From b0e452bfe16aa746c55dc70c22a7841dd5c5e471 Mon Sep 17 00:00:00 2001
From: Otavio Salvador <otavio@ossystems.com.br>
Date: Fri, 13 Nov 2026 13:49:28 -0300
Subject: [PATCH 4/4] samples: mgmt: updatehub: pin the UpdateHub root CAs for
 DTLS

The DTLS build registered a server certificate and its private key as
the device's own credentials and never set a trust anchor, so peer
verification could not succeed. The bundled certificate was a 2048-bit
RSA one that expired in 2020, and the README told users to generate a
server key and embed it in the device.

UpdateHub Cloud authenticates with ECDSA P-256 certificates signed by
an UpdateHub root CA, and devices only need the roots:

- ship UpdateHub Device Root CA R1, which signs the current server
  certificate, and R2, a standby root, so the server can move to R2
  without a firmware update
- register them as one TLS_CREDENTIAL_CA_CERTIFICATE under
  UPDATEHUB_DTLS_SEC_TAG and stop shipping a private key. TLS
  credentials hold one credential per type and tag, so the roots are
  kept as a single NUL-terminated PEM bundle, which Mbed TLS parses
  into one CA chain
- add UPDATEHUB_SAMPLE_ROOT_CA_FILE so the roots can be replaced, for
  example to test against a local server
- switch overlay-dtls.conf to TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
  with extended master secret and PEM parsing. A handshake peaks at
  about 10 KiB of Mbed TLS heap, but the first-fit allocator fragments
  and 16 KiB already failed with both roots on native_sim/native/64,
  so use 24 KiB. The handshake runs in the system work queue or shell
  thread, which prj.conf already sizes, so the main stack override is
  dropped
- rewrite README step 2.2 accordingly

Signed-off-by: Otavio Salvador <otavio@ossystems.com.br>
---
 samples/subsys/mgmt/updatehub/CMakeLists.txt  |  19 +++---
 samples/subsys/mgmt/updatehub/Kconfig         |  10 +++
 samples/subsys/mgmt/updatehub/README.rst      |  58 +++++++++++-------
 .../subsys/mgmt/updatehub/overlay-dtls.conf   |  16 +++--
 .../mgmt/updatehub/src/c_certificates.h       |  17 +++--
 .../updatehub/src/certificates/privkey.der    | Bin 1218 -> 0 bytes
 .../updatehub/src/certificates/servercert.der | Bin 879 -> 0 bytes
 .../src/certificates/updatehub-root-ca.pem    |  29 +++++++++
 samples/subsys/mgmt/updatehub/src/main.c      |  16 +----
 9 files changed, 103 insertions(+), 62 deletions(-)
 delete mode 100644 samples/subsys/mgmt/updatehub/src/certificates/privkey.der
 delete mode 100644 samples/subsys/mgmt/updatehub/src/certificates/servercert.der
 create mode 100644 samples/subsys/mgmt/updatehub/src/certificates/updatehub-root-ca.pem

diff --git a/samples/subsys/mgmt/updatehub/CMakeLists.txt b/samples/subsys/mgmt/updatehub/CMakeLists.txt
index 8356b458c9d..94efd0b19ba 100644
--- a/samples/subsys/mgmt/updatehub/CMakeLists.txt
+++ b/samples/subsys/mgmt/updatehub/CMakeLists.txt
@@ -13,16 +13,11 @@ project(updatehub)
 target_sources(app PRIVATE src/main.c)
 
 if(CONFIG_UPDATEHUB_DTLS)
-    set(gen_dir ${ZEPHYR_BINARY_DIR}/include/generated/)
-
-    foreach(inc_file
-            servercert.der
-            privkey.der
-            )
-        generate_inc_file_for_target(
-            ${ZEPHYR_CURRENT_LIBRARY}
-            src/certificates/${inc_file}
-            ${gen_dir}/${inc_file}.inc
-            )
-    endforeach()
+  get_filename_component(root_ca ${CONFIG_UPDATEHUB_SAMPLE_ROOT_CA_FILE}
+    ABSOLUTE BASE_DIR ${CMAKE_CURRENT_SOURCE_DIR}
+  )
+  generate_inc_file_for_target(app
+    ${root_ca}
+    ${ZEPHYR_BINARY_DIR}/include/generated/updatehub-root-ca.pem.inc
+  )
 endif()
diff --git a/samples/subsys/mgmt/updatehub/Kconfig b/samples/subsys/mgmt/updatehub/Kconfig
index 4ff7572e1a2..60820319382 100644
--- a/samples/subsys/mgmt/updatehub/Kconfig
+++ b/samples/subsys/mgmt/updatehub/Kconfig
@@ -29,4 +29,14 @@ config UPDATEHUB_SAMPLE_WIFI_PSK
 	default "secret_passwd"
 endif
 
+config UPDATEHUB_SAMPLE_ROOT_CA_FILE
+	string "UpdateHub root CA certificates (PEM)"
+	default "src/certificates/updatehub-root-ca.pem"
+	depends on UPDATEHUB_DTLS
+	help
+	  PEM file with the root CA certificates that may sign the UpdateHub
+	  server certificate. All of them are registered as one DTLS trust
+	  anchor credential. Relative paths are resolved from the sample
+	  directory.
+
 source "Kconfig.zephyr"
diff --git a/samples/subsys/mgmt/updatehub/README.rst b/samples/subsys/mgmt/updatehub/README.rst
index 6c7ac40a0dc..45305ffc1e0 100644
--- a/samples/subsys/mgmt/updatehub/README.rst
+++ b/samples/subsys/mgmt/updatehub/README.rst
@@ -103,30 +103,44 @@ Step 2.2: UpdateHub Cloud
 The UpdateHub Cloud is an enterprise-grade solution.  It provides almost same
 resources than UpdateHub-CE with the DTLS as main diferential.  For more
 details on how to use the UpdateHub Cloud please refer to the documentation on
-`updatehub.io`_.  The UpdateHub Cloud has the option to use CoAPS/DTLS or not.
-If you want to use the CoAPS/DTLS, simply add the ``overlay-dtls.conf`` when
-building the sample.  You can use the provided certificate for test this
-example or create your own.  The below procedure instruct how create a new
-certificate using openssl on a Linux machine on terminal ``terminal 2``.
-
-.. code-block:: console
-
-    openssl genrsa -out privkey.pem 512
-    openssl req -new -x509 -key privkey.pem -out servercert.pem
-
-The ``servercert`` and ``privkey`` files must be embedded in the application
-by ``certificates.h`` file.  The following procedure can be used to generated
-the required ``der`` files:
-
-.. code-block:: console
-
-    openssl x509 -in servercert.pem -outform DER -out servercert.der
-    openssl pkcs8 -topk8 -inform PEM -outform DER -nocrypt -in privkey.pem
-      -out privkey.der
+`updatehub.io`_.
+
+The UpdateHub Cloud accepts plain CoAP on port 5683 and CoAPS (DTLS 1.2) on
+port 5684.  To use CoAPS, add ``overlay-dtls.conf`` when building the sample.
+The server authenticates with an ECDSA P-256 certificate signed by an
+UpdateHub root CA, and the device verifies that chain and the server name
+:kconfig:option:`CONFIG_UPDATEHUB_SERVER`.  The device does not authenticate
+itself with a certificate, so it never holds a private key.
+
+The sample ships the UpdateHub root CA certificates in
+:zephyr_file:`samples/subsys/mgmt/updatehub/src/certificates/updatehub-root-ca.pem`
+and registers them as one ``TLS_CREDENTIAL_CA_CERTIFICATE`` under the security
+tag :kconfig:option:`CONFIG_UPDATEHUB_DTLS_SEC_TAG`:
+
+* ``UpdateHub Device Root CA R1``, which signs the current server certificate,
+  SHA-256 fingerprint
+  ``D2:D8:AB:2C:24:05:FC:1D:71:85:7C:96:62:3C:B6:60:11:2A:D2:32:77:74:89:52:29:CA:58:88:E7:02:49:3E``
+* ``UpdateHub Device Root CA R2``, a standby root, so the server can move to
+  it without a firmware update, SHA-256 fingerprint
+  ``73:E8:0C:AE:CF:AD:A9:4E:89:0C:EC:F4:E1:C0:D1:39:F6:90:D5:E8:EB:D7:7E:74:09:3D:7B:29:A0:1D:C2:AB``
+
+Keep both roots in products so they keep working when the server moves to the
+standby root.  Zephyr keeps one credential per type and security tag, so several
+roots must share one PEM file rather than be added one by one.
+
+To test against a server of your own, build with
+``CONFIG_UPDATEHUB_SAMPLE_ROOT_CA_FILE`` pointing to a PEM file with the root
+CA that signs that server's certificate, and set
+:kconfig:option:`CONFIG_UPDATEHUB_SERVER` to a name present in the server
+certificate.
 
+.. note::
 
-The ``der`` files should be placed on the sample source at certificates
-directory.
+    Certificate validity dates are only checked when
+    :kconfig:option:`CONFIG_MBEDTLS_HAVE_TIME_DATE` is enabled, which requires a
+    trusted wall clock (for example SNTP or an RTC) to be set before the first
+    connection.  With the option enabled and no valid clock, the handshake
+    rejects every certificate as not yet valid.
 
 .. note::
 
diff --git a/samples/subsys/mgmt/updatehub/overlay-dtls.conf b/samples/subsys/mgmt/updatehub/overlay-dtls.conf
index d0a22ff4e31..5c4b333e166 100644
--- a/samples/subsys/mgmt/updatehub/overlay-dtls.conf
+++ b/samples/subsys/mgmt/updatehub/overlay-dtls.conf
@@ -5,9 +5,15 @@
 #
 
 CONFIG_UPDATEHUB_DTLS=y
-#Minimal TLS configuration
-CONFIG_MAIN_STACK_SIZE=3000
+
+# UpdateHub Cloud uses DTLS 1.2 with ECDSA P-256 certificates
+CONFIG_MBEDTLS_CIPHERSUITE_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256=y
+CONFIG_PSA_WANT_ECC_SECP_R1_256=y
+CONFIG_MBEDTLS_SSL_EXTENDED_MASTER_SECRET=y
+# The root CA file is a PEM bundle
+CONFIG_MBEDTLS_PEM_PARSE_C=y
+
+# A handshake peaks around 10 KiB in use, but the first-fit allocator
+# fragments: 16 KiB already failed with both roots on a 64-bit target
+CONFIG_MBEDTLS_HEAP_SIZE=24576
 CONFIG_NET_BUF_RX_COUNT=50
-CONFIG_MBEDTLS_HEAP_SIZE=60000
-CONFIG_MBEDTLS_CIPHERSUITE_TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256=y
-# End tls configs
diff --git a/samples/subsys/mgmt/updatehub/src/c_certificates.h b/samples/subsys/mgmt/updatehub/src/c_certificates.h
index b1a455a3239..394e5bafddc 100644
--- a/samples/subsys/mgmt/updatehub/src/c_certificates.h
+++ b/samples/subsys/mgmt/updatehub/src/c_certificates.h
@@ -8,16 +8,13 @@
 #define __CERTIFICATE_H__
 
 #if defined(CONFIG_UPDATEHUB_DTLS)
-#define CA_CERTIFICATE_TAG 1
-
-static const unsigned char server_certificate[] = {
-    #include "servercert.der.inc"
-};
-
-
-static const unsigned char private_key[] = {
-    #include "privkey.der.inc"
+/* Mbed TLS only parses PEM, and so more than one certificate, from a
+ * NUL-terminated buffer.
+ */
+static const unsigned char updatehub_root_ca[] = {
+#include "updatehub-root-ca.pem.inc"
+0x00
 };
-
 #endif
+
 #endif /* __CERTIFICATE_H__ */
